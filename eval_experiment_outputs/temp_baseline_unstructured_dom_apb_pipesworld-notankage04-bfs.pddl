(define (domain pipesworld-notankage04-bfs)
  (:requirements :strips :typing)
  (:types
    batch-atom area pipe - object
  )
  (:predicates
    (normal ?p - pipe)
    (unitary ?p - pipe)
    (may-interface ?p1 - batch-atom ?p2 - batch-atom)
    (connect ?a1 - area ?a2 - area ?p - pipe)
    (on ?b - batch-atom ?a - area)
    (first ?b - batch-atom ?p - pipe)
    (last ?b - batch-atom ?p - pipe)
  )
  (:action push-start
    :parameters (?a - pipe ?b - batch-atom ?c - area ?d - area ?e - batch-atom ?f - batch-atom ?g - batch-atom)
    :precondition (and
      (normal ?a)
      (first ?e ?a)
      (connect ?c ?d ?a)
      (on ?b ?c)
      (not (unitary ?a))
      (product ?b ?f)
      (product ?e ?g)
      (may-interface ?f ?g)
    )
    :effect (and
      (not (normal ?a))
      (not (first ?e ?a))
      (not (on ?b ?c))
      (being-push-updated ?a)
      (first ?b ?a)
      (last ?e ?a)
    )
  )
  (:action push-end
    :parameters (?a - pipe ?d - batch-atom ?e - batch-atom ?b - area ?c - area)
    :precondition (and
      (being-push-updated ?a)
      (last ?d ?a)
      (connect ?b ?c ?a)
      (not (unitary ?a))
      (follows ?d ?e)
    )
    :effect (and
      (normal ?a)
      (last ?e ?a)
      (on ?d ?c)
      (not (being-push-updated ?a))
      (not (follows ?d ?e))
      (not (last ?d ?a))
    )
  )
  (:action pop-start
    :parameters (?a - pipe ?b - batch-atom ?e - batch-atom ?f - batch-atom ?g - batch-atom ?c - area ?d - area)
    :precondition (and
      (normal ?a)
      (last ?e ?a)
      (connect ?c ?d ?a)
      (on ?b ?d)
      (not (unitary ?a))
      (product ?b ?f)
      (product ?e ?g)
      (may-interface ?f ?g)
    )
    :effect (and
      (not (normal ?a))
      (not (last ?e ?a))
      (not (on ?b ?d))
      (being-pop-updated ?a)
      (last ?b ?a)
      (follows ?e ?b)
    )
  )
  (:action pop-end
    :parameters (?a - pipe ?d - batch-atom ?e - batch-atom ?b - area ?c - area)
    :precondition (and
      (being-pop-updated ?a)
      (first ?d ?a)
      (connect ?b ?c ?a)
      (not (unitary ?a))
      (follows ?d ?e)
    )
    :effect (and
      (normal ?a)
      (first ?e ?a)
      (on ?d ?b)
      (not (being-pop-updated ?a))
      (not (follows ?d ?e))
      (not (first ?d ?a))
    )
  )
  (:action push-unitary
    :parameters (?a - pipe ?b - batch-atom ?c - area ?d - area ?e - batch-atom ?f - batch-atom ?g - batch-atom)
    :precondition (and
      (first ?e ?a)
      (connect ?c ?d ?a)
      (on ?b ?c)
      (unitary ?a)
      (product ?b ?f)
      (product ?e ?g)
      (may-interface ?f ?g)
    )
    :effect (and
      (first ?b ?a)
      (last ?b ?a)
      (on ?e ?d)
      (not (first ?e ?a))
      (not (last ?e ?a))
      (not (on ?b ?c))
    )
  )
  (:action pop-unitary
    :parameters (?a - pipe ?b - batch-atom ?c - area ?d - area ?e - batch-atom ?f - batch-atom ?g - batch-atom)
    :precondition (and
      (last ?e ?a)
      (connect ?c ?d ?a)
      (on ?b ?d)
      (unitary ?a)
      (product ?b ?f)
      (product ?e ?g)
      (may-interface ?f ?g)
    )
    :effect (and
      (last ?b ?a)
      (first ?b ?a)
      (on ?e ?c)
      (not (last ?e ?a))
      (not (first ?e ?a))
      (not (on ?b ?d))
    )
  )
)