(define (domain pegsol08)
  (:requirements :strips)
  (:predicates
    (occupied ?pos)
    (free ?pos)
    (in-line ?pos1 ?pos2 ?pos3)
    (move-ended)
    (last-visited ?pos)
  )
  (:action jump-new-move
    :parameters (?A ?B ?C)
    :precondition (and
      (move-ended)
      (occupied ?A)
      (occupied ?B)
      (free ?C)
      (in-line ?A ?B ?C)
    )
    :effect (and
      (not (occupied ?A))
      (not (occupied ?B))
      (occupied ?C)
      (not (move-ended))
      (not (free ?C))
      (last-visited ?C)
    )
  )
  (:action continue-jump
    :parameters (?A ?B ?C)
    :precondition (and
      (last-visited ?A)
      (occupied ?A)
      (occupied ?B)
      (free ?C)
      (in-line ?A ?B ?C)
    )
    :effect (and
      (not (occupied ?A))
      (not (occupied ?B))
      (occupied ?C)
      (not (free ?C))
      (not (last-visited ?A))
      (last-visited ?C)
    )
  )
  (:action end-move
    :parameters (?A)
    :precondition (last-visited ?A)
    :effect (and
      (move-ended)
      (not (last-visited ?A))
    )
  )
)