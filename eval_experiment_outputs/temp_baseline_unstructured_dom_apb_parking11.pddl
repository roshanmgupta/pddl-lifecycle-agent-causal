(define (domain parking11)
  (:requirements :strips)
  (:predicates
    (at ?car ?curb)
    (behind ?car1 ?car2)
    (clear ?object)
  )
  (:action move-from-curb-to-curb
    :parameters (?car - car ?curbB - curb ?curbC - curb)
    :precondition (and (clear ?car) (clear ?curbC) (at ?car ?curbB))
    :effect (and (not (at ?car ?curbB))
                 (not (clear ?curbC))
                 (at ?car ?curbC)
                 (clear ?curbB))
  )
  (:action move-from-curb-to-behind
    :parameters (?car - car ?curbB - curb ?carC - car)
    :precondition (and (clear ?car) (clear ?carC) (at ?car ?curbB) (at ?carC ?curbB))
    :effect (and (not (at ?car ?curbB))
                 (not (clear ?carC))
                 (behind ?car ?carC)
                 (clear ?curbB))
  )
  (:action move-from-behind-to-curb
    :parameters (?car - car ?carB - car ?curbC - curb)
    :precondition (and (clear ?car) (clear ?curbC) (behind ?car ?carB))
    :effect (and (not (behind ?car ?carB))
                 (not (clear ?curbC))
                 (at ?car ?curbC)
                 (clear ?carB))
  )
  (:action move-from-behind-to-behind
    :parameters (?car - car ?carB - car ?carC - car)
    :precondition (and (clear ?car) (clear ?carC) (behind ?car ?carB) (at ?carC ?curb))
    :effect (and (not (behind ?car ?carB))
                 (not (clear ?carC))
                 (behind ?car ?carC)
                 (clear ?carB))
  )
)