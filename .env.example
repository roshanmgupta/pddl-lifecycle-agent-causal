# ==============================================================================
# PDDL Lifecycle Agent - Environment Configuration Template
# Copy this file to .env and configure your OpenRouter API key and model choices.
# ==============================================================================

# OpenRouter API Key (Sole supported LLM inference provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Strict Phase-to-Model Mapping
# Model identifiers as registered on OpenRouter (e.g. deepseek/deepseek-chat, openai/gpt-4o-mini)
LLM_PHASE_1=deepseek/deepseek-chat
LLM_PHASE_3=deepseek/deepseek-chat
LLM_PHASE_4=deepseek/deepseek-chat

# Classical Symbolic Planning Oracles (VAL & Fast Downward)
# Configure paths relative to repository root or absolute system paths
VAL_PATH=tools/bin/VAL/build/bin/Validate.exe
FAST_DOWNWARD_PATH=tools/bin/downward/fast-downward.py

# ==============================================================================
# Reference Benchmark Datasets
# Specify directory paths for canonical benchmark datasets.
# Active benchmark: PDDLLifeCycleBench (24 domains with curated flaws & evolutions).
# Uncomment AutoPlanBench or NL2PDDL when switching to those evaluation tracks.
# ==============================================================================
# Active Benchmarks: AutoPlanBench (original) & NL2PDDL (original)
# Only domains with pure (:requirements :strips :typing) are enabled.
AUTOPLANBENCH_DIR=autoplanbench/data
NL2PDDL_DIR=NL2PDDL/test

# --- Prompt Benchmark Folders (Commented out - using original folders) ---
# AUTOPLANBENCH_PROMPTS_DIR=prompt_autoplanbench
# NL2PDDL_PROMPTS_DIR=prompt_NL2PDDL

# --- Other Benchmarks (Commented out) ---
# PDDLLIFECYCLEBENCH_DIR=PDDLLifeCycleBench

# ==============================================================================
# Temporary Working & Solver Files
# Paths for intermediate validation, solver translation, and plan synthesis.
# ==============================================================================
TEMP_DOMAIN_PATH=temp_domain.pddl
TEMP_PROBLEM_PATH=temp_problem.pddl
TEMP_GT_DOMAIN_PATH=temp_domain_gt.pddl
TEMP_PLAN_PATH=sas_plan
TEMP_EVAL_PLAN_PATH=temp_eval_plan.txt

# ==============================================================================
# Generated Output Directories & Artifacts
# Configures storage locations for compiled domain, problem, and plan files.
# ==============================================================================
# Evaluation Experiment Runner & Scratch Outputs
OUTPUT_DIR_EVAL=eval_experiment_outputs
GENERATED_OUTPUT_DIR=eval_experiment_outputs
OUTPUT_DIR_FLAW=PDDLLifeCycleBench_Output_Flaw
OUTPUT_DIR_EVOLVE=PDDLLifeCycleBench_Output__Evolve
OUTPUT_DIR_ELICITATION=PDDLLifeCycleBench_Output_Elicitation

# Generated Filename Templates
GENERATED_DOMAIN_FILE=domain.pddl
GENERATED_PROBLEM_FILE=problem.pddl
GENERATED_PLAN_FILE=plan.txt

